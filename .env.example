# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.
#   cp .env.example .env

COMPOSE_PROJECT_NAME=lakehouse

# Mat khau dich vu (doi truoc khi dung that)
POSTGRES_USER=hduser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=iceberg_catalog

# Mang Docker
DOCKER_SUBNET=172.18.0.0/16

# Duong dan HDFS
HDFS_NAMESERVICE=hadoop-namenode
HDFS_DEFAULTFS=hdfs://hadoop-namenode
HDFS_WAREHOUSE=/warehouse

# Iceberg
ICEBERG_CATALOG=iceberg
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres:5432/iceberg_catalog

# Kafka
KAFKA_TOPIC=stock-quotes
KAFKA_REPLICATION_FACTOR=3

# Superset / Airflow
SUPERSET_SECRET_KEY=change_me_too
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Nguon du lieu chung khoan (GD 8)
STOCK_API_BASE_URL=
STOCK_API_KEY=
