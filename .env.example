# Sao chep file nay thanh .env roi dien gia tri that. KHONG commit file .env.
#   cp .env.example .env

# Mat khau dich vu (doi truoc khi dung that)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=metastore

# MinIO (S3) - trong cum K8s
MINIO_ENDPOINT=http://minio-service:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me

# Iceberg
ICEBERG_CATALOG=iceberg
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres-service:5432/metastore
ICEBERG_WAREHOUSE=s3a://cleansed-zone/warehouse

# Kafka
KAFKA_TOPIC=stock-quotes
KAFKA_REPLICATION_FACTOR=3

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Nguon du lieu chung khoan
STOCK_API_BASE_URL=
STOCK_API_KEY=
